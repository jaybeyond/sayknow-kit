{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SayKnow Kit",
  "version": "0.2.2",
  "identifier": "com.sayknow.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "SayKnow Kit",
        "width": 480,
        "height": 580,
        "minWidth": 320,
        "maxWidth": 820,
        "minHeight": 200,
        "maxHeight": 900,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Menu bar AI kit — translate, chat, clipboard",
    "longDescription": "SayKnow Kit is a menu bar AI toolkit: instant translation, chat, and clipboard history in one popover. Bring your own OpenRouter key, or point it at any OpenAI-compatible endpoint.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
