---
// The app's popover, drawn in HTML so it stays sharp at any size and shows
// only made-up content. Labels the app shows (tabs, chips, filters, limits)
// come from the app's own strings; the example content from landing.ts.
import { UI_STRINGS } from "../../../src/i18n/strings"
import { LANDING } from "../i18n/landing"
import type { FeatureId, Locale } from "../data/site"

interface Props {
  panel: FeatureId
  locale: Locale
  class?: string
}

const { panel, locale, class: extra } = Astro.props
const s = (key: string) => UI_STRINGS[locale][key] ?? UI_STRINGS.en[key] ?? key
const m = LANDING[locale].mock
const tabFor: Record<FeatureId, string> = {
  translate: "translate",
  chat: "chat",
  clipboard: "clipboard",
  system: "tools",
  usage: "tools",
  providers: "translate",
}
const tabs = ["translate", "chat", "clipboard", "tools"] as const
const active = tabFor[panel]
const toolTabs = ["status", "display", "usage", "mole"] as const

/** A deterministic wiggly series, so the graphs look alive but never change between builds. */
function series(seed: number, base: number, swing: number, n = 48): number[] {
  const out: number[] = []
  let v = base
  for (let i = 0; i < n; i++) {
    const r = Math.sin(seed * 12.9898 + i * 78.233) * 43758.5453
    v += (r - Math.floor(r) - 0.5) * swing
    v = Math.min(98, Math.max(3, v * 0.9 + base * 0.1))
    out.push(v)
  }
  return out
}
function path(values: number[], w = 120, h = 24): string {
  return values
    .map((v, i) => `${i ? "L" : "M"}${((i / (values.length - 1)) * w).toFixed(1)} ${(h - (v / 100) * h).toFixed(1)}`)
    .join(" ")
}
const metrics = [
  { label: "CPU", value: "23%", d: path(series(1, 24, 18)) },
  { label: "GPU", value: "41%", d: path(series(2, 38, 26)) },
  { label: s("tools.metrics.memory"), value: "68%", d: path(series(3, 66, 4)) },
  { label: s("tools.metrics.temperature"), value: "61 °C", d: path(series(4, 58, 6)) },
]
const providers: [string, string, boolean][] = [
  ["OpenRouter", m.models, true],
  ["Claude", m.signedIn, false],
  ["Codex", m.signedIn, false],
  ["NVIDIA", "nvapi-…", false],
  ["Z.AI", "GLM", false],
  ["Custom", "http://localhost:1234/v1", false],
]
---

<div class:list={["mock", extra]} data-panel={panel} aria-hidden="true">
  <div class="mock-head">
    {tabs.map((t) => <span class:list={["mock-tab", { on: t === active }]}>{s(`tab.${t}`)}</span>)}
    <span class="mock-dots"><i></i><i></i><i></i></span>
  </div>

  {
    panel === "translate" && (
      <div class="mock-body">
        <div class="mock-langs">
          <span class="chip on">{m.from}</span>
          <span class="swap">⇄</span>
          <span class="chip">{m.to}</span>
        </div>
        <p class="mock-input">
          {m.input}
          <span class="caret" />
        </p>
        <div class="mock-rule">
          <span>{m.to.toUpperCase()}</span>
        </div>
        <p class="mock-output">{m.output}</p>
        <div class="mock-chips">
          {["refine.polite", "refine.casual", "refine.shorter", "refine.business", "refine.literal"].map((k, i) => (
            <span class:list={["chip", { on: i === 3 }]}>{s(k)}</span>
          ))}
        </div>
      </div>
    )
  }

  {
    panel === "chat" && (
      <div class="mock-body chat">
        <div class="bubble me">{m.chatQuestion}</div>
        <div class="bubble ai">{m.chatAnswer}</div>
        <div class="bubble me">{m.chatFollowUp}</div>
        <div class="bubble ai typing">
          <i />
          <i />
          <i />
        </div>
        <div class="mock-field">{s("chat.placeholder")}</div>
      </div>
    )
  }

  {
    panel === "clipboard" && (
      <div class="mock-body">
        <div class="mock-field search">{s("clipboard.search")}</div>
        <div class="mock-chips">
          <span class="chip on">{s("clipboard.filterAll")}</span>
          <span class="chip">{s("clipboard.filterClips")}</span>
          <span class="chip">{s("clipboard.filterMemos")}</span>
        </div>
        <ul class="clips">
          <li class="memo">
            <b>{s("clipboard.memoBadge")}</b> {m.memo}
          </li>
          <li class="pinned">
            <b>📌</b> https://github.com/jaybeyond/sayknow-kit
          </li>
          <li>
            {m.input}
            <small>{m.ago2}</small>
          </li>
          <li>
            {m.output}
            <small>{m.ago5}</small>
          </li>
        </ul>
      </div>
    )
  }

  {
    (panel === "system" || panel === "usage") && (
      <div class="mock-body">
        <div class="mock-subtabs">
          {toolTabs.map((t) => (
            <span class:list={{ on: (panel === "system" && t === "status") || (panel === "usage" && t === "usage") }}>
              {s(`tools.tabs.${t}`)}
            </span>
          ))}
        </div>
        {panel === "system" ? (
          <>
            <div class="metrics">
              {metrics.map((x) => (
                <div class="metric">
                  <span>{x.label}</span>
                  <svg viewBox="0 0 120 24" preserveAspectRatio="none">
                    <path d={x.d} />
                  </svg>
                  <b>{x.value}</b>
                </div>
              ))}
            </div>
            <div class="toplist">
              <span>CPU</span>
              <ol>
                <li>
                  Xcode <b>142%</b>
                </li>
                <li>
                  Safari <b>38%</b>
                </li>
                <li>
                  Figma <b>21%</b>
                </li>
              </ol>
            </div>
          </>
        ) : (
          <div class="usage-card">
            <div class="usage-top">
              <b>Claude Code</b>
              <small>{s("usage.justNow")}</small>
            </div>
            {[
              [s("usage.limit.short"), 34, m.resetFive],
              [s("usage.limit.long"), 61, m.resetWeek],
            ].map(([label, pct, reset]) => (
              <div class="limit">
                <span>{label}</span>
                <b>{pct}%</b>
                <svg viewBox="0 0 100 4" preserveAspectRatio="none">
                  <rect width="100" height="4" rx="2" class="track" />
                  <rect width={pct} height="4" rx="2" class="fill" />
                </svg>
                <small>{reset}</small>
              </div>
            ))}
            <div class="usage-nums">
              {[
                ["usage.window.today", "18.2M"],
                ["usage.window.week", "241M"],
                ["usage.window.month", "1.02B"],
              ].map(([k, v]) => (
                <div>
                  <small>{s(k)}</small>
                  <b>{v}</b>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    )
  }

  {
    panel === "providers" && (
      <div class="mock-body">
        <ul class="providers">
          {providers.map(([name, detail, on]) => (
            <li class:list={{ on }}>
              <b>{name}</b>
              <small>{detail}</small>
              {on && <span class="check">✓</span>}
            </li>
          ))}
        </ul>
      </div>
    )
  }
</div>
