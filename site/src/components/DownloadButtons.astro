---
import type { Release } from "../data/release"
import type { Copy } from "../i18n"

interface Props {
  release: Release
  t: Copy
}

const { release, t } = Astro.props
---

<div class="downloads" data-platform-group>
  <a class="btn primary" data-platform="mac" data-asset="mac" href={release.mac.url}>
    <strong>{t.home.macButton}</strong>
    <span>{t.home.macDetail}</span>
  </a>
  <a class="btn" data-platform="win" data-asset="winExe" href={release.winExe.url}>
    <strong>{t.home.winButton}</strong>
    <span>{t.home.winDetail}</span>
  </a>
</div>

<script>
  import "../scripts/release-refresh.ts"
</script>
