---
import "../styles/global.css"
import { copyFor } from "../i18n"
import { HTML_LANG, LOCALES, LOCALE_NAMES, REPO_URL, localePath, type Locale } from "../data/site"

type NavKey = "home" | "features" | "download" | "changelog" | "shortcuts" | "feedback" | "privacy"

interface Props {
  locale: Locale
  /** Path inside the locale, without slashes: "", "features/translate", … */
  path: string
  title?: string
  description?: string
  current: NavKey
}

const { locale, path, title, description, current } = Astro.props
const t = copyFor(locale)
const pageTitle = title ? `${title} — SayKnow Kit` : t.meta.title
const pageDescription = description ?? t.meta.description
const site = Astro.site
const abs = (p: string) => (site ? new URL(p, site).toString() : undefined)
const header: NavKey[] = ["features", "download", "changelog", "feedback"]
const footer: NavKey[] = ["shortcuts", "privacy"]
const href = (key: NavKey) => localePath(locale, key === "home" ? "" : key)
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline src="/theme-init.js"></script>
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fafaf9" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#121212" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content="sayknow.ai" />
    {abs("/icon.png") && <meta property="og:image" content={abs("/icon.png")} />}
    {abs(localePath(locale, path)) && <link rel="canonical" href={abs(localePath(locale, path))} />}
    {
      site &&
        LOCALES.map((l) => <link rel="alternate" hreflang={HTML_LANG[l]} href={abs(localePath(l, path))} />)
    }
    {site && <link rel="alternate" hreflang="x-default" href={abs(localePath("en", path))} />}
  </head>
  <body>
    <a class="skip" href="#main">{t.nav.skip}</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={href("home")} aria-label="SayKnow Kit — sayknow.ai">
          <span class="wordmark" aria-hidden="true"></span>
          <span class="brand-kit">Kit</span>
        </a>
        <nav class="nav" aria-label={t.nav.features}>
          {
            header.map((key) => (
              <a href={href(key)} aria-current={current === key ? "page" : undefined}>
                {t.nav[key]}
              </a>
            ))
          }
        </nav>
        <button class="theme-toggle" type="button" data-theme-toggle data-label-dark={t.nav.themeDark} data-label-light={t.nav.themeLight} aria-label={t.nav.themeDark}>
          <svg class="moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a6.8 6.8 0 0 0 10.7 10.7Z"></path>
          </svg>
          <svg class="sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
          </svg>
        </button>
        <details class="lang">
          <summary aria-label={t.nav.language}>{LOCALE_NAMES[locale]}</summary>
          <ul>
            {
              LOCALES.map((l) => (
                <li>
                  <a href={localePath(l, path)} hreflang={HTML_LANG[l]} lang={HTML_LANG[l]} aria-current={l === locale ? "true" : undefined}>
                    {LOCALE_NAMES[l]}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
      </div>
    </header>

    <main id="main">
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span class="footer-brand"><span class="wordmark small" role="img" aria-label="sayknow.ai"></span> SayKnow Kit · {t.footer.license}</span>
        <nav aria-label="footer">
          {footer.map((key) => <a href={href(key)}>{t.nav[key]}</a>)}
          <a href={REPO_URL}>{t.footer.source}</a>
        </nav>
      </div>
    </footer>
    <script>
      import { startThemeToggle } from "../scripts/theme"
      startThemeToggle()
    </script>
  </body>
</html>
