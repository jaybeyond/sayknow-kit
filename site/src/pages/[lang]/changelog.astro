---
import Base from "../../layouts/Base.astro"
import { copyFor } from "../../i18n"
import { CHANGELOG } from "../../data/changelog"
import { formatDate, localeParams, versionAnchor } from "../../data/build"
import { RELEASES_URL, type Locale } from "../../data/site"

export function getStaticPaths() {
  return localeParams()
}

const locale = Astro.params.lang as Locale
const t = copyFor(locale)
---

<Base locale={locale} path="changelog" current="changelog" title={t.changelog.title}>
  <header class="page-head">
    <h1>{t.changelog.title}</h1>
    <p>{t.changelog.intro}</p>
  </header>
  <div class="releases">
    {
      CHANGELOG.map((entry, i) => (
        <section class="release" id={versionAnchor(entry.version)}>
          <div>
            <h2>v{entry.version}</h2>
            <time datetime={entry.date}>{formatDate(entry.date, locale)}</time>
            {i === 0 && (
              <div>
                <span class="badge">{t.home.latest}</span>
              </div>
            )}
          </div>
          <ul>
            {entry.notes[locale].map((note) => (
              <li>{note}</li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
  <p class="muted section"><a href={RELEASES_URL}>{t.changelog.older}</a></p>
</Base>
