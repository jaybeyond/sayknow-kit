---
import Base from "../../layouts/Base.astro"
import DownloadButtons from "../../components/DownloadButtons.astro"
import { copyFor } from "../../i18n"
import { buildRelease, formatDate, localeParams } from "../../data/build"
import { COMMANDS, formatBytes } from "../../data/release"
import { RELEASES_URL, type Locale } from "../../data/site"

export function getStaticPaths() {
  return localeParams()
}

const locale = Astro.params.lang as Locale
const t = copyFor(locale)
const release = await buildRelease()
const files = [
  { key: "mac", asset: release.mac, label: "macOS · Apple Silicon" },
  { key: "winExe", asset: release.winExe, label: "Windows · x64 · NSIS" },
  { key: "winMsi", asset: release.winMsi, label: "Windows · x64 · MSI" },
  { key: "sums", asset: release.sums, label: "SHA-256" },
] as const
---

<Base locale={locale} path="download" current="download" title={t.download.title}>
  <header class="page-head" data-release={release.version}>
    <h1>{t.download.title}</h1>
    <p>{t.download.intro}</p>
    <p class="muted">
      <b data-release-version>v{release.version}</b>
      {release.date && <span data-release-date={t.home.released}> · {t.home.released.replace("{date}", formatDate(release.date, locale))}</span>}
    </p>
  </header>

  <DownloadButtons release={release} t={t} />

  <section class="section">
    <h2>{t.download.fileHeading}</h2>
    <div class="table-scroll">
      <table class="table">
        <thead>
          <tr><th>{t.download.fileCol}</th><th></th><th class="num">{t.download.sizeCol}</th></tr>
        </thead>
        <tbody>
          {
            files.map((f) => (
              <tr>
                <td>
                  <a data-asset={f.key} href={f.asset.url}>
                    <code data-asset-name>{f.asset.name}</code>
                  </a>
                </td>
                <td class="muted">{f.label}</td>
                <td class="num muted">{formatBytes(f.asset.bytes)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p><a class="text-link" data-release-url href={release.url}>{t.download.allReleases}</a></p>
  </section>

  <section class="section two-col">
    <div class="panel">
      <h2>{t.download.macTitle}</h2>
      <ol class="steps">{t.download.macSteps.map((s) => <li>{s}</li>)}</ol>
      <p class="muted cmd-lead">{t.download.macTerminal}</p>
      <pre class="cmd"><code>{COMMANDS.quarantine}</code></pre>
    </div>
    <div class="panel">
      <h2>{t.download.winTitle}</h2>
      <ol class="steps">{t.download.winSteps.map((s) => <li>{s}</li>)}</ol>
    </div>
  </section>

  <section class="section two-col">
    <div>
      <h2>{t.download.securityTitle}</h2>
      <ul class="plain muted">{t.download.securityBody.map((s) => <li>{s}</li>)}</ul>
      <h2 class="section">{t.download.checksumTitle}</h2>
      <p class="muted">{t.download.checksumBody}</p>
      <pre class="cmd"><code>{`# macOS\n${COMMANDS.shasum.replace("<version>", release.version)}\n\n# Windows\n${COMMANDS.certutil.replace("<version>", release.version)}`}</code></pre>
    </div>
    <div>
      <h2>{t.download.requirementsTitle}</h2>
      <ul class="plain muted">{t.download.requirements.map((s) => <li>{s}</li>)}</ul>
      <h2 class="section">{t.download.updatesTitle}</h2>
      <p class="muted">{t.download.updatesBody}</p>
      <h2 class="section">{t.download.uninstallTitle}</h2>
      <ul class="plain muted">{t.download.uninstall.map((s) => <li>{s}</li>)}</ul>
    </div>
  </section>
  <p class="muted"><a href={RELEASES_URL}>GitHub Releases</a></p>
</Base>
