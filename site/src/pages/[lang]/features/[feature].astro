---
import Base from "../../../layouts/Base.astro"
import { copyFor } from "../../../i18n"
import { FEATURE_IDS, LOCALES, localePath, type FeatureId, type Locale } from "../../../data/site"

export function getStaticPaths() {
  return LOCALES.flatMap((lang) => FEATURE_IDS.map((feature) => ({ params: { lang, feature } })))
}

const locale = Astro.params.lang as Locale
const id = Astro.params.feature as FeatureId
const t = copyFor(locale)
const f = t.features.items[id]
const index = FEATURE_IDS.indexOf(id)
const prev = index > 0 ? FEATURE_IDS[index - 1] : null
const next = index < FEATURE_IDS.length - 1 ? FEATURE_IDS[index + 1] : null
---

<Base locale={locale} path={`features/${id}`} current="features" title={f.name} description={f.summary}>
  <div class="feature-layout">
    <nav class="feature-nav" aria-label={t.features.allFeatures}>
      {
        FEATURE_IDS.map((other) => (
          <a href={localePath(locale, `features/${other}`)} aria-current={other === id ? "page" : undefined}>
            {t.features.items[other].name}
          </a>
        ))
      }
    </nav>
    <article>
      <header class="page-head">
        <h1>{f.name}</h1>
        <p>{f.summary}</p>
      </header>
      <ul class="points">
        {
          f.points.map((p) => (
            <li>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </li>
          ))
        }
      </ul>
      {
        f.notes.length > 0 && (
          <aside class="notes">
            <h2>{t.features.notesTitle}</h2>
            <ul>
              {f.notes.map((n) => (
                <li>{n}</li>
              ))}
            </ul>
          </aside>
        )
      }
      <nav class="pager" aria-label={t.features.allFeatures}>
        {prev ? <a class="text-link back" href={localePath(locale, `features/${prev}`)}>← {t.features.items[prev].name}</a> : <span />}
        {next ? <a class="text-link" href={localePath(locale, `features/${next}`)}>{t.features.items[next].name}</a> : <span />}
      </nav>
    </article>
  </div>
</Base>
