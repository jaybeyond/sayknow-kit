---
import Base from "../../layouts/Base.astro"
import { copyFor } from "../../i18n"
import { buildRelease, localeParams } from "../../data/build"
import { issueFormUrl } from "../../data/feedback"
import { ISSUES_URL, type Locale } from "../../data/site"

export function getStaticPaths() {
  return localeParams()
}

const locale = Astro.params.lang as Locale
const t = copyFor(locale)
const release = await buildRelease()
---

<Base locale={locale} path="feedback" current="feedback" title={t.feedback.title}>
  <header class="page-head">
    <h1>{t.feedback.title}</h1>
    <p>{t.feedback.intro}</p>
  </header>

  <div class="two-col">
    <section class="panel action-card">
      <h2>{t.feedback.bugTitle}</h2>
      <p>{t.feedback.bugBody}</p>
      <a class="btn primary" href={issueFormUrl("bug", release.version)}><strong>{t.feedback.bugCta}</strong></a>
    </section>
    <section class="panel action-card">
      <h2>{t.feedback.ideaTitle}</h2>
      <p>{t.feedback.ideaBody}</p>
      <a class="btn" href={issueFormUrl("idea", release.version)}><strong>{t.feedback.ideaCta}</strong></a>
    </section>
  </div>
  <p class="muted">{t.feedback.account} <a href={ISSUES_URL}>{t.feedback.browse}</a></p>

  <div class="two-col section">
    <section>
      <h2>{t.feedback.beforeTitle}</h2>
      <ul class="plain muted">{t.feedback.before.map((s) => <li>{s}</li>)}</ul>
    </section>
    <section>
      <h2>{t.feedback.logsTitle}</h2>
      <ul class="plain muted">
        {t.feedback.logs.map((s, i) => <li>{i < 2 ? <code>{s}</code> : s}</li>)}
      </ul>
    </section>
  </div>
</Base>
