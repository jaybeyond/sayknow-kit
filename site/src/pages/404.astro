---
import "../styles/global.css"
import { HTML_LANG, LOCALES, LOCALE_NAMES, localePath } from "../data/site"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline src="/theme-init.js"></script>
    <title>Not found — SayKnow Kit</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body>
    <main id="main">
      <div class="wrap">
        <header class="page-head">
          <h1>404</h1>
          <p>This page does not exist.</p>
        </header>
        <ul class="plain">
          {
            LOCALES.map((l) => (
              <li>
                <a href={localePath(l)} hreflang={HTML_LANG[l]} lang={HTML_LANG[l]}>
                  {LOCALE_NAMES[l]}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </main>
  </body>
</html>
