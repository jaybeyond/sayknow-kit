---
// The bare address picks a language: the browser's preference if it is one
// the site speaks, otherwise English. Without script, a plain list of links.
import "../styles/global.css"
import { HTML_LANG, LOCALES, LOCALE_NAMES, localePath } from "../data/site"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline src="/theme-init.js"></script>
    <title>SayKnow Kit</title>
    <meta name="description" content="Translation, chat, clipboard history and system tools one shortcut away. Free and open source." />
    <link rel="icon" type="image/png" href="/favicon.png" />
    {Astro.site && LOCALES.map((l) => <link rel="alternate" hreflang={HTML_LANG[l]} href={new URL(localePath(l), Astro.site).toString()} />)}
  </head>
  <body>
    <main id="main">
      <div class="wrap">
        <section class="hero">
          <img class="hero-icon" src="/icon.png" alt="" width="84" height="84" />
          <h1>SayKnow Kit</h1>
          <ul class="plain" data-locales={LOCALES.join(",")}>
            {
              LOCALES.map((l) => (
                <li>
                  <a href={localePath(l)} hreflang={HTML_LANG[l]} lang={HTML_LANG[l]}>
                    {LOCALE_NAMES[l]}
                  </a>
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </main>
    <script>
      import { pickLocale } from "../data/pick-locale"
      const list = document.querySelector<HTMLElement>("[data-locales]")
      const supported = (list?.dataset.locales ?? "").split(",")
      const locale = pickLocale(navigator.languages ?? [navigator.language], supported)
      location.replace(`/${locale}/`)
    </script>
  </body>
</html>
