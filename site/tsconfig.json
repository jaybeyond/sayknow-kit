{
  // Self-contained on purpose: the app's `vitest run` also loads the site's
  // tests, and it runs where the site's node_modules are not installed, so
  // extending "astro/tsconfigs/strict" would not resolve there. These are that
  // preset's options. The tests are type-checked by the app's own toolchain,
  // not by `astro check`, which has no vitest types.
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "jsx": "preserve",
    "strict": true,
    "types": ["node"]
  },
  "include": [".astro/types.d.ts", "src/**/*", "scripts/**/*"],
  "exclude": ["dist", "src/**/*.test.ts"]
}
